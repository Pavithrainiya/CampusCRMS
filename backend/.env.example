# Copy to .env and adjust for your local PostgreSQL instance.
# docker compose up -d  (from CampusRMS/) provides these defaults.

DATABASE_URL=postgresql://postgres:1234@localhost:5432/campusrms_db
DB_NAME=campusrms_db
DB_USER=postgres
DB_PASSWORD=1234
DB_HOST=localhost
DB_PORT=5432
DB_SSL_REQUIRE=False

DEBUG=True
SECRET_KEY=change-me-in-production
